{
  "cleanUrls": true,
  "redirects": [
    { "source": "/enroll", "destination": "https://articulateleader.mykajabi.com/enroll", "permanent": false },
    { "source": "/enroll.html", "destination": "https://articulateleader.mykajabi.com/enroll", "permanent": false },
    { "source": "/community", "destination": "https://articulateleader.mykajabi.com/products/communities/v2/thearticulateleadercommunity/home", "permanent": false },
    { "source": "/login", "destination": "https://articulateleader.mykajabi.com/login", "permanent": false }
  ],
  "headers": [
    {
      "source": "/qr/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
